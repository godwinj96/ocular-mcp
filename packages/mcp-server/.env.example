# Port the Fastify + MCP Streamable HTTP server listens on.
MCP_SERVER_PORT=3000

# WorkOS dashboard -> API Keys page.
AUTHKIT_CLIENT_ID=client_xxxxxxxxxxxxxxxxxxxxxxxxx
# WorkOS dashboard -> API Keys page. NEVER commit the real value.
AUTHKIT_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WorkOS dashboard -> AuthKit -> your tenant's issuer URL, after completing the
# one-time setup in docs/rules/04-mcp-server-and-auth.md §1 (protected resource
# registration, DCR + CIMD, social connections).
AUTHKIT_ISSUER_URL=https://your-tenant.authkit.app

# The resource identifier registered with WorkOS as the MCP protected resource
# (becomes the `aud` claim every token is checked against).
AUTHKIT_RESOURCE_IDENTIFIER=https://mcp.useocular.dev

# Mirrors JWKS_CACHE_TTL_S in packages/shared/src/constants.ts — keep in sync.
AUTHKIT_JWKS_CACHE_TTL_S=600

# Optional, comma-separated. Origin allowlist for /mcp — leave unset/empty
# unless there's an actual browser-based caller (e.g. a future in-dashboard
# playground); real MCP clients never send an Origin header at all.
MCP_ALLOWED_ORIGINS=

# Upstash console -> your Redis database -> Details tab ("Endpoint"/"Password").
REDIS_URL=rediss://default:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@your-db.upstash.io:6379

# Neon console -> your project -> Connection Details -> "Pooled connection".
POSTGRES_URL=postgresql://user:xxxxxxxxxxxxxxxxxxxxxx@your-project-pooler.your-region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# The dashboard's base URL — /worker/heartbeat forwards here after
# authenticating the caller (see src/internal/dashboard-client.ts and
# docs/rules/02-repo-structure.md §0.6; the dashboard owns worker/audit
# persistence). A deployment-internal address, not necessarily the public one.
DASHBOARD_INTERNAL_URL=http://localhost:3001

# Shared secret with the dashboard's /api/internal/* routes. Generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
# and set the SAME value in packages/dashboard's INTERNAL_SERVICE_SECRET.
INTERNAL_SERVICE_SECRET=REDACTED

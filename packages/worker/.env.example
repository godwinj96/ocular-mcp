# Same Upstash Redis instance as packages/mcp-server/.env.example — the
# worker consumes RENDER_QUEUE_NAME from this connection.
REDIS_URL=rediss://default:REDACTED@your-instance.upstash.io:6379

# Webshare dashboard -> Proxy List / Endpoints. Powers both rung 0 (dc-proxy,
# no -rotate suffix) and rung 1 (residential-proxy, -rotate suffix appended
# in code — see ladder/rung-profiles.ts). Optional: rung 0 falls back to a
# proxyless bundle if unset; rung 1 is simply unavailable (ladder exhaustion)
# without it.
WEBSHARE_PROXY_URL=p.webshare.io:80
WEBSHARE_PROXY_CREDENTIALS=username:password

# Decodo dashboard -> Site Unblocker -> credentials. Rung 3 (paid-unblocker) —
# a synchronous forward-proxy request (unblock.decodo.com:60000), NOT the
# separate scraper-api.decodo.com REST product. Pro-tier accounts only (see
# @ocular/shared's MAX_RUNG_INDEX_BY_TIER).
DECODO_UNBLOCKER_USERNAME=REDACTED
DECODO_UNBLOCKER_PASSWORD=REDACTED

# Camoufox (rung 2) is deferred post-launch — no vendor account, no env var
# yet. DataImpulse (rung 1's originally-planned vendor) was dropped in favor
# of Webshare's residential product after DataImpulse's signup was blocked.

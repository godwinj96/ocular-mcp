WORKOS_CLIENT_ID=client_REDACTED
WORKOS_API_KEY=sk_test_REDACTED
WORKOS_COOKIE_PASSWORD=REDACTED_32_CHAR_MINIMUM
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3001/callback
REDIS_URL=rediss://default:REDACTED@your-instance.upstash.io:6379
POSTGRES_URL=postgresql://user:REDACTED@your-host.neon.tech/neondb?sslmode=require

# This deploy's own public URL — used to build Bachs checkout success/cancel
# URLs and the hosted-portal return URL (see lib/bachs.ts). Real Vercel URL
# in staging/production.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Bachs dashboard -> API Keys. sk_sandbox_ routes to Bachs's sandbox API
# automatically; swap for the sk_live_ key at launch, no code change needed.
BACHS_API_KEY=sk_sandbox_REDACTED

# Bachs dashboard -> Webhooks -> add an endpoint pointing at this deploy's
# /webhooks/bachs route -> the signing secret is shown once when the
# endpoint is created. Verifies the X-Bachs-Signature + X-Bachs-Timestamp
# headers (HMAC-SHA256 over `${timestamp}.${rawBody}`) on
# checkout.completed, customer.subscription.created/updated/deleted, and
# invoice.paid/payment_failed events (see docs/rules/11-billing-and-quota.md §3).
BACHS_WEBHOOK_SECRET=whsec_REDACTED

# Bachs dashboard -> Products -> one product per plan tier x billing cycle
# (used as checkout-session line items' product_id — see lib/bachs.ts and
# @ocular/shared's plans.ts for the Basic/Pro x Monthly/Annual scheme).
BACHS_BASIC_MONTHLY_PRICE_ID=prod_REDACTED
BACHS_BASIC_ANNUAL_PRICE_ID=prod_REDACTED
BACHS_PRO_MONTHLY_PRICE_ID=prod_REDACTED
BACHS_PRO_ANNUAL_PRICE_ID=prod_REDACTED

# Shared secret with mcp-server's DASHBOARD_INTERNAL_URL calls (see
# app/api/internal/worker-heartbeat/route.ts and
# docs/rules/02-repo-structure.md §0.6). Generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
# and set the SAME value in packages/mcp-server's INTERNAL_SERVICE_SECRET.
INTERNAL_SERVICE_SECRET=REDACTED

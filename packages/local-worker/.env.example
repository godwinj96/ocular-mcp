# Local-worker env vars — NOT YET documented in docs/rules/12-environment-and-secrets.md
# (flagged as a gap during the PRD v0.2 reconciliation; add there once the
# Phase 8 install-time credential-issuance flow replaces manual placement
# here). See src/config.ts for the fail-open defaults each of these has.

# Where cloud-routed captures forward to. Defaults to a local dev mcp-server.
OCULAR_CLOUD_MCP_URL=http://localhost:3000/mcp

# Static API key for cloud-path auth AND the subscription-validity signal
# (see src/subscription/validate.ts). Issue one from the dashboard
# (docs/rules/11-billing-and-quota.md §4) — this is a stand-in for the real
# install-time flow, not the final design.
OCULAR_API_KEY=

# Comma-separated hostnames explicitly routed to the local path beyond
# localhost/private-IP (e.g. a custom /etc/hosts dev domain).
OCULAR_LOCAL_DOMAINS=

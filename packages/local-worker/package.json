{
  "name": "useocular",
  "version": "0.1.0",
  "description": "Read-only visual perception for AI coding agents — local dev-server capture via MCP. Connects your agent to your own browser, no cloud round-trip.",
  "private": false,
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "ocular": "./bin/ocular.js"
  },
  "files": [
    "bin",
    "dist",
    "supervisor-checksums.json",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godwinj96/ocular-mcp.git",
    "directory": "packages/local-worker"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/bundle.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "build:supervisor": "node scripts/build-supervisor.cjs",
    "test:supervisor": "cd supervisor && go test ./..."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@ocular/shared": "*",
    "pino": "^9.5.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  }
}

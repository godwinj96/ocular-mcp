# Build output (applies at every level — packages/*/dist, packages/*/.next, etc.)
dist/
build/
.next/
tmp/

# Dependencies (applies at every level — packages/*/node_modules)
node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# dotenv environment variable files (applies at every level)
.env
.env.development
.env.test
.env.production
.env.local

# local-scope MCP config that can contain plaintext API keys/tokens — never commit
.mcp.json

# coverage output
coverage/

# temp directory
.temp
.tmp

# Next.js auto-regenerates this on every dev/build run and explicitly
# instructs "do not edit" — gitignoring avoids repeated lint friction over a
# file nobody hand-writes (packages/dashboard).
next-env.d.ts

# TypeScript incremental build cache — regenerated locally, never meant to
# be committed (accidentally swept into the dashboard commit's git add).
*.tsbuildinfo

# Local Claude Code session state (settings, skill cache, scheduler locks) —
# machine-specific, not shared project config.
.claude/

# Crash artifacts from a Windows bash.exe stdio-pipe segfault seen this
# session — never intentional output, safe to ignore wherever it lands.
bash.exe.stackdump
